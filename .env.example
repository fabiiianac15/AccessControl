# Configuración del Sistema de Control de Acceso
# Copia este archivo como .env y ajusta los valores según tu entorno

# Base de datos
DB_PATH=access_control.db

# Rutas de carpetas
PHOTOS_PATH=access_photos
TEMP_PATH=temp_images
EXPORTS_PATH=exports

# Configuración de cámara
CAMERA_INDEX=0
FRAME_SKIP=3
RESOLUTION_SCALE=0.5

# Umbral de reconocimiento facial (0.0 - 1.0, menor = más estricto)
FACE_RECOGNITION_TOLERANCE=0.6

# Logging
LOG_LEVEL=INFO
