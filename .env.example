# Copia este archivo como .env. Todas las variables son opcionales salvo donde se indica.

# Quién responde por los datos. Aparecen en el panel y en el formato de autorización.
PORTERO_ORG_NAME="Universidad Francisco de Paula Santander Ocaña"
PORTERO_PRIVACY_CONTACT="datospersonales@tu-organizacion.edu.co"
PORTERO_TIMEZONE=America/Bogota

# Datos: base de datos, modelos y clave. Respalda esta carpeta.
PORTERO_DATA_DIR=data
PORTERO_HOST=127.0.0.1
PORTERO_PORT=8000

# Clave maestra en base64 (32 bytes): `openssl rand -base64 32`.
# Si falta, se crea data/secret.key. Sin ella no se pueden leer las plantillas ni verificar registros.
# PORTERO_MASTER_KEY=

# Retención de eventos, en días. Programa `portero purge` a diario para aplicarla.
PORTERO_RETENTION_DAYS=180

# Guardar foto cifrada de los accesos denegados. Es un dato personal más: actívalo solo si lo necesitas.
PORTERO_STORE_DENIED_PHOTOS=false

# Reconocimiento. docs/evaluacion.md explica de dónde salen estos valores.
# PORTERO_MATCH_THRESHOLD=0.45
# PORTERO_MATCH_MARGIN=0.05
# PORTERO_LIVENESS_TURN_RATIO=0.28
# PORTERO_LIVENESS_MIN_ASPECT=0.65
